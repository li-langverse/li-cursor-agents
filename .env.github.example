# Shared GitHub credentials for li-langverse (gitignored).
# Typical location: coding-projects/.env.github (sibling to lic, benchmarks, li-cursor-agents)
#
#   cp .env.github.example ../.env.github
#   chmod 600 ../.env.github
#
# Fine-grained PAT: repo access on li-langverse/* (and your fork if you push branches).

GH_TOKEN=github_pat_REPLACE_ME
GH_USER=cap-jmk-real
GH_ORG=li-langverse
