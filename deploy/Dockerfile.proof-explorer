# Proof Explorer goal-directed agent — prebuilt image with gh + lic workspace sync.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 git ca-certificates curl bash \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build && npm prune --omit=dev

COPY deploy/proof-explorer-entrypoint.sh /app/deploy/proof-explorer-entrypoint.sh
COPY deploy/proof-explorer-k8s-entrypoint.sh /app/deploy/proof-explorer-k8s-entrypoint.sh
COPY deploy/world-studio-gui-product-visual-entrypoint.sh /app/deploy/world-studio-gui-product-visual-entrypoint.sh
COPY deploy/li-toml-config-entrypoint.sh /app/deploy/li-toml-config-entrypoint.sh
COPY deploy/k8s-goal-loop-common.sh /app/deploy/k8s-goal-loop-common.sh
COPY scripts/goal-loop-self-unblock.sh /app/scripts/goal-loop-self-unblock.sh
RUN chmod +x /app/deploy/proof-explorer-entrypoint.sh \
    /app/deploy/proof-explorer-k8s-entrypoint.sh \
    /app/deploy/world-studio-gui-product-visual-entrypoint.sh \
    /app/deploy/li-toml-config-entrypoint.sh \
    /app/deploy/k8s-goal-loop-common.sh \
    /app/scripts/goal-loop-self-unblock.sh

ENV NODE_ENV=production
ENTRYPOINT ["/app/deploy/proof-explorer-entrypoint.sh"]
