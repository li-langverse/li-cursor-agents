# Template only — apply real values via kubectl (never commit secrets).
#
#   source ~/launchpad/.env   # GITLAB_TOKEN, GH_TOKEN, CURSOR_API_KEY
#   bash scripts/setup-engine-k8s-pure-li-https.sh
#
# Or manually:
#   kubectl -n li-swarm create secret generic li-agents-secrets \
#     --from-literal=GITLAB_TOKEN="$GITLAB_TOKEN" \
#     --from-literal=GH_TOKEN="$GH_TOKEN" \
#     --from-literal=CURSOR_API_KEY="$CURSOR_API_KEY" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Keys:
#   GITLAB_TOKEN      — required: git clone/push, GitLab Issues/MRs (org-swarm VCS API)
#   GHCR_PUSH_TOKEN   — optional: push ghcr.io/li-langverse/li-cursor-agents (image publish only)
#   GH_TOKEN          — optional legacy: GHCR pull / GitHub fallback when LI_VCS_PROVIDER=github
#   CURSOR_API_KEY    — Cursor SDK agents
apiVersion: v1
kind: Secret
metadata:
  name: li-agents-secrets
  namespace: li-swarm
type: Opaque
stringData:
  GITLAB_TOKEN: replace-me
  GH_TOKEN: replace-me-optional-during-transition
  CURSOR_API_KEY: replace-me
