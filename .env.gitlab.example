# GitLab PAT for li-langverse (clone/push/MR API).
# Copy to ../.env.gitlab at workspace root (or li/.env.gitlab) — never commit secrets.
#
# Create PAT: https://gitlab.lilangverse.xyz/-/user_settings/personal_access_tokens
# Scopes: read_repository, write_repository (api optional for MR/issue automation)
#
GITLAB_TOKEN=
