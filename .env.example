# Copy to li-cursor-agents/.env (gitignored):
#   cp .env.example .env
#
# API key — create at https://cursor.com/dashboard → Integrations / API
# (any one of these names works; CURSOR_API_KEY is preferred)
CURSOR_API_KEY=
# CURSOR_SDK_KEY=
# CURSOR_SDK=
#
# Verify: ./scripts/check-sdk-key.sh && ./scripts/sdk-smoke.sh
# Cloud Agent VM: set same vars in Cursor → Cloud Agent → Environment, then restart VM
#
# Local SDK: use `default` (Auto). Explicit composer-2 may error on some keys.
CURSOR_MODEL=default
BENCHMARKS_ROOT=../benchmarks
