# Copy to li-cursor-agents/.env (gitignored):
#   cp .env.example .env
#
# --- Cursor SDK (default for dashboard / supervisor / agents:keep) ---
# Create at https://cursor.com/dashboard → Integrations / API
# Required for real runs. Do not set CURSOR_MOCK here (tests set it in npm test).
CURSOR_API_KEY=
# CURSOR_SDK_KEY=
# CURSOR_SDK=
CURSOR_MODEL=default
BENCHMARKS_ROOT=../benchmarks
#
# --- GitHub (gh CLI + preflight: PR queue, org audits) ---
# Preferred: shared sibling file (same as lic):
#   ../.env.github   ← copy from below or from li/scripts/with-github-env.sh
# Or set here / in .env:
GH_TOKEN=
GH_USER=cap-jmk-real
GH_ORG=li-langverse
#
# gh also reads GITHUB_TOKEN; loadRuntimeEnv mirrors GH_TOKEN → GITHUB_TOKEN when set.
#
# Verify GitHub:
#   gh auth status
#   cd ../benchmarks && python3 scripts/pr-merge-queue-plan.py
#
# Verify SDK:
#   ./scripts/check-sdk-key.sh && ./scripts/sdk-smoke.sh
#
# --- Local Supabase (control plane primary store) ---
# supabase start   # from li-cursor-agents/
# supabase db reset
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Optional: disable disk JSON cache (DB-only)
# LI_EXPORT_DISK_CACHE=0
