# Copy to li-cursor-agents/.env (gitignored):
#   cp .env.example .env
#
# --- Cursor SDK (default for dashboard / supervisor / agents:keep) ---
# Create at https://cursor.com/dashboard → Integrations / API
# Required for real runs. Do not set CURSOR_MOCK here (tests set it in npm test).
CURSOR_API_KEY=
# CURSOR_SDK_KEY=
# CURSOR_SDK=
# Use `default` (Cursor Auto) for local SDK — `composer-2` often instant-errors without tool calls
CURSOR_MODEL=default
# CURSOR_SDK_FALLBACK_MODEL=default
BENCHMARKS_ROOT=../benchmarks
LI_LOCAL_CI_ROOT=../li-local-ci
LI_GITHUB_ENV=../.env.github
#
# --- Auto-merge (pr_merger; dry-run always, real merge only when enabled) ---
# LI_AUTO_MERGE=1
# LI_TRUSTED_MERGE_APPROVED=1   # required when merge_plan touches trusted.lean
# LI_SWARM_MERGE_RECOMMENDATIONS=0   # disable prepending swarm lane agents to recommended_agents
#
# --- Local CI (replaces GitHub Actions when quota exceeded) ---
# Supervisor runs local-ci-sweep before pr_merger. See ../li-local-ci/README.md
LI_USE_LOCAL_CI=1
LI_LOCAL_CI_SWEEP_LIMIT=2
LI_LOCAL_CI_MAX_AGE_HOURS=48
LI_LOCAL_CI_PRUNE=always
LI_LOCAL_CI_SKIP_GH=1
#
# --- Isolated workspaces (data/workspaces/) ---
LI_WORKSPACE_PRUNE=always
LI_WORKSPACE_PRUNE_MAX_AGE_DAYS=7
LI_WORKSPACE_PRUNE_KEEP_PER_REPO=5
LI_WORKSPACE_PRUNE_MAX_RUNS_PER_REPO=20
# LI_WORKSPACE_PRUNE_INTERVAL_MS=3600000
# npm run workspace:prune -- --dry-run
# LI_USE_LOCAL_CI=0
# LI_SKIP_LOCAL_CI_SWEEP=1
#
# --- Supervisor (one machine) ---
LI_SUPERVISOR_INTERVAL_MS=120000
LI_AGENTS_COOLDOWN_MS=300000
LI_SUPERVISOR_MAX_TASKS=2
LI_AGENT_DASHBOARD_PORT=9477
# LI_DASHBOARD_UI_PORT=3000
# npm run dev:all — Supabase + full API + async swarm + Next.js UI (see scripts/dev-all.sh)
# LI_AUTO_START_ASYNC_SWARM=0   # dev:all default is 1; set 0 to start swarm manually in UI
#
# --- SDK slots (see docs/ecosystem/sdk-slot-policy.md) ---
# LI_SDK_MAX_CONCURRENT=4       # cross-process slot cap (lanes + worker pool; default 4)
# LI_SWARM_PAUSE_WORKERS=1      # skip agent worker pool (burst/plan executor uses slots)
#
# --- Control-plane store (pick one; default supabase) ---
# LI_CONTROL_PLANE_STORE=supabase   # needs Docker — npm run db:ensure
# LI_CONTROL_PLANE_STORE=disk       # JSON under data/ (CI/tests)
# LI_EXPORT_DISK_CACHE=1            # optional mirror when store=supabase
# LI_STACK_SKIP_SUPABASE=1          # legacy alias → disk
# LI_SUPABASE_DB_RESET=1            # destructive: supabase db reset on ensure
#
# --- GitHub (gh CLI + preflight: PR queue, org audits) ---
# Preferred: shared sibling file (same as lic):
#   ../.env.github   ← copy from below or from li/scripts/with-github-env.sh
# Or set here / in .env:
GH_TOKEN=
GH_USER=cap-jmk-real
GH_ORG=li-langverse
#
# gh also reads GITHUB_TOKEN; loadRuntimeEnv mirrors GH_TOKEN → GITHUB_TOKEN when set.
#
# Verify GitHub:
#   gh auth status
#   cd ../benchmarks && python3 scripts/pr-merge-queue-plan.py
#
# Verify SDK:
#   ./scripts/check-sdk-key.sh && ./scripts/sdk-smoke.sh
#
# --- Local Supabase (filled by npm run setup / ensure-supabase) ---
# npm run db:ensure  # writes .env.supabase; setup merges into .env
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres for read-only agent SQL (default local supabase db port)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# LI_CONTROL_PLANE_DB_MCP=0   # disable MCP tools on Cursor SDK agents
# Optional: disable disk JSON cache (DB-only)
# LI_EXPORT_DISK_CACHE=0
