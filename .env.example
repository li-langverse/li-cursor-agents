# Copy to li-cursor-agents/.env (gitignored):
#   cp .env.example .env
#
# --- Cursor SDK (default for dashboard / supervisor / agents:keep) ---
# Create at https://cursor.com/dashboard → Integrations / API
# Required for real runs. Do not set CURSOR_MOCK here (tests set it in npm test).
CURSOR_API_KEY=
# CURSOR_SDK_KEY=
# CURSOR_SDK=
CURSOR_MODEL=default
BENCHMARKS_ROOT=../benchmarks
LI_LOCAL_CI_ROOT=../li-local-ci
LI_GITHUB_ENV=../.env.github
#
# --- Local CI (replaces GitHub Actions when quota exceeded) ---
# Supervisor runs local-ci-sweep before pr_merger. See ../li-local-ci/README.md
LI_USE_LOCAL_CI=1
LI_LOCAL_CI_SWEEP_LIMIT=2
LI_LOCAL_CI_MAX_AGE_HOURS=48
LI_LOCAL_CI_PRUNE=always
LI_LOCAL_CI_SKIP_GH=1
# LI_USE_LOCAL_CI=0
# LI_SKIP_LOCAL_CI_SWEEP=1
#
# --- Supervisor (one machine) ---
LI_SUPERVISOR_INTERVAL_MS=120000
LI_AGENTS_COOLDOWN_MS=300000
LI_SUPERVISOR_MAX_TASKS=2
LI_AGENT_DASHBOARD_PORT=9477
#
# --- Stack / disk (Supabase needs Docker ~2GB+) ---
# LI_STACK_SKIP_SUPABASE=1
# LI_STACK_USE_SUPABASE=1
#
# --- GitHub (gh CLI + preflight: PR queue, org audits) ---
# Preferred: shared sibling file (same as lic):
#   ../.env.github   ← copy from below or from li/scripts/with-github-env.sh
# Or set here / in .env:
GH_TOKEN=
GH_USER=cap-jmk-real
GH_ORG=li-langverse
#
# gh also reads GITHUB_TOKEN; loadRuntimeEnv mirrors GH_TOKEN → GITHUB_TOKEN when set.
#
# Verify GitHub:
#   gh auth status
#   cd ../benchmarks && python3 scripts/pr-merge-queue-plan.py
#
# Verify SDK:
#   ./scripts/check-sdk-key.sh && ./scripts/sdk-smoke.sh
#
# --- Local Supabase (control plane primary store) ---
# supabase start   # from li-cursor-agents/
# supabase db reset
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Optional: disable disk JSON cache (DB-only)
# LI_EXPORT_DISK_CACHE=0
